<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>so101_pose_milestone</name>
  <version>0.1.0</version>
  <description>Task-space pose commander for the SO-101 with independent PoE forward-kinematics verification.</description>
  <maintainer email="you@example.com">Jackie</maintainer>
  <license>MIT</license>

  <!-- Build tool for an ament_python package -->
  <buildtool_depend>ament_python</buildtool_depend>

  <!-- Runtime dependencies. rosdep reads these to install what is missing. -->
  <exec_depend>rclpy</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>moveit_py</exec_depend>
  <exec_depend>moveit_configs_utils</exec_depend>
  <exec_depend>python3-numpy</exec_depend>

  <!-- The robot this package targets. Present so colcon builds them first. -->
  <exec_depend>so101_description</exec_depend>
  <exec_depend>so101_moveit_config</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
